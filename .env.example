# Copiar a .env y llenar. El .env nunca se sube a git (ver .gitignore).
#   cp .env.example .env ; chmod 600 .env

# --- postgres (lo genero yo, no lo toques) --------------------------
PG_PASSWORD=CAMBIAR

# --- MercadoLibre ---------------------------------------------------
# developers.mercadolibre.cl -> Crear aplicacion
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Sin root: ML te devuelve al sitio, tu copias la URL y la pegas con /codigo.
ML_REDIRECT_URI=https://TU-SERVIDOR.ejemplo.net/
# Con el path publico abierto (ver BASE_PUBLICA), cambiar a:
# ML_REDIRECT_URI=https://TU-SERVIDOR.ejemplo.net/cazador/oauth/callback
ML_SITE=MLC

# --- Telegram -------------------------------------------------------
# @BotFather -> /newbot -> pega el token aca
TG_TOKEN=
# palabra secreta: la mandas una vez con  /start LA_PALABRA
TG_PASS=cambiala

# --- red ------------------------------------------------------------
# VACIO = modo sin root: nada del cazador sale a internet. El sistema pregunta
# a ML cada 5 min en vez de recibir avisos push. Funciona igual, avisa hasta
# 5 min mas tarde.
#
# Para el modo push hay que correr UNA vez, con root:
#   sudo tailscale serve --bg --https=443 --set-path=/cazador http://127.0.0.1:8010
# y recien ahi poner:
#   BASE_PUBLICA=https://TU-SERVIDOR.ejemplo.net/cazador
BASE_PUBLICA=

# --- LLM local ------------------------------------------------------
OLLAMA_MODELO=huihui_ai/qwen3-abliterated:8b
